# Copy this file to .env for local runs. Never commit .env (it is git-ignored).
# On Railway, set these in the service's Variables tab instead.
# Never put the Kraken API key in this file or in the repo.

# --- Hosted page login (required) ---
# Login name for the Karen page.
KAREN_USER=
# Login password for the page. Use a long random one.
KAREN_PASSWORD=

# --- Hosted service settings (optional) ---
# How often to refresh prices and re-run the paper portfolio, in minutes. Default 60.
REFRESH_MINUTES=60
# Port the page listens on. Railway sets this automatically.
PORT=8080

# --- Live trader: used by live.py, or by server.py when KAREN_RUN_TRADER=ON. ---
# Kraken API key. Permissions: Funds Query, Query open/closed orders & trades,
# Create & modify orders. NEVER Withdraw. Set on Railway, not in a committed file.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Folder for saved positions. On Railway, point this at a mounted volume (e.g. /data).
KAREN_STATE_DIR=state
# ON = run the trader inside the dashboard service (server.py), so the page shows it.
# Leave OFF if you run python live.py separately. Never run both with the same key.
KAREN_RUN_TRADER=OFF

# --- Live trading switch (keep OFF) ---
# Real orders need BOTH this set to ON and LIVE_TRADING = True in config.py.
# With either off, live.py sends orders with validate=true: Kraken checks them, places nothing.
KAREN_LIVE_TRADING=OFF
